    msgLbl.Text = message
    msgLbl.TextColor3 = T.TEXT_DIM
    msgLbl.Font = Enum.Font.Gotham
    msgLbl.TextSize = 9
    msgLbl.TextXAlignment = Enum.TextXAlignment.Left
    msgLbl.TextTruncate = Enum.TextTruncate.AtEnd
    msgLbl.Parent = notif

    local timerBar = Instance.new("Frame")
    timerBar.Size = UDim2.new(1, -10, 0, 2)
    timerBar.Position = UDim2.new(0, 5, 1, -3)
    timerBar.BackgroundColor3 = accentColor
    timerBar.BorderSizePixel = 0
    timerBar.Parent = notif
    corner(timerBar, 999)

    TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0)
    }):Play()

    TweenService:Create(timerBar, TweenInfo.new(2.5, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0, 0, 0, 2)
    }):Play()

    task.delay(2.5, function()
        if notif and notif.Parent then
            TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Position = UDim2.new(0, 0, 0, -60),
                BackgroundTransparency = 1,
            }):Play()
            task.wait(0.35)
            if notif and notif.Parent then notif:Destroy() end
        end
    end)
end

