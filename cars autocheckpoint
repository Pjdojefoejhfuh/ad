-- ═══════════════════════════════════════════════
local notifContainer = nil
local notifOrder = 0

local function buildNotifContainer(parent)
    if notifContainer and notifContainer.Parent then return notifContainer end
    local c = Instance.new("Frame")
    c.Name = "NotifContainer"
    c.Size = UDim2.new(0, 280, 1, -40)
    c.Position = UDim2.new(0.5, -140, 0, 20)
    c.BackgroundTransparency = 1
    c.Parent = parent
    local l = Instance.new("UIListLayout")
    l.Padding = UDim.new(0, 6)
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.HorizontalAlignment = Enum.HorizontalAlignment.Center
    l.VerticalAlignment = Enum.VerticalAlignment.Top
    l.Parent = c
    notifContainer = c
    return c
end

local function showNotif(parent, title, message, notifType)
    notifType = notifType or "info"
    notifOrder = notifOrder + 1
    local container = buildNotifContainer(parent)

    local accentColor, icon
    if notifType == "success" then accentColor = T.SUCCESS; icon = "✓"
    elseif notifType == "error" then accentColor = T.DANGER; icon = "✕"
    elseif notifType == "warn" then accentColor = T.WARN; icon = "!"
    else accentColor = T.WHITE; icon = "★" end

    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, 280, 0, 46)
    notif.BackgroundColor3 = T.BG
    notif.BackgroundTransparency = 0.05
    notif.BorderSizePixel = 0
    notif.Position = UDim2.new(0, 0, 0, -60)
    notif.LayoutOrder = notifOrder
    notif.ClipsDescendants = true
    notif.Parent = container
    corner(notif, 10)

    local nStroke = Instance.new("UIStroke")
    nStroke.Thickness = 1.4
    nStroke.Transparency = 0.1
    nStroke.Color = accentColor
    nStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    nStroke.Parent = notif

    local sGrad = Instance.new("UIGradient")
    sGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, T.OFF),
        ColorSequenceKeypoint.new(0.5, accentColor),
        ColorSequenceKeypoint.new(1, T.OFF),
    })
    sGrad.Rotation = 90
    sGrad.Parent = nStroke
    registerGradient(sGrad, 120)

    local leftBar = Instance.new("Frame")
    leftBar.Size = UDim2.new(0, 2, 1, -12)
    leftBar.Position = UDim2.new(0, 5, 0, 6)
    leftBar.BackgroundColor3 = accentColor
    leftBar.BorderSizePixel = 0
    leftBar.Parent = notif
    corner(leftBar, 999)

    local iconLbl = Instance.new("TextLabel")
    iconLbl.Size = UDim2.new(0, 18, 0, 18)
    iconLbl.Position = UDim2.new(0, 12, 0.5, -9)
    iconLbl.BackgroundTransparency = 1
    iconLbl.Text = icon
    iconLbl.TextColor3 = accentColor
    iconLbl.Font = Enum.Font.GothamBlack
    iconLbl.TextSize = 14
    iconLbl.Parent = notif

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1, -40, 0, 14)
    titleLbl.Position = UDim2.new(0, 36, 0, 6)
