-- 🚶 MOUVEMENT
-- ═══════════════════════════════════════════════
local gui, panel, startBtn, stopBtn, statusDot, statusTitle, statusDetail, progressFill, progressText, timerText = createUI()

local function setStatus(title, detail, color)
    statusTitle.Text = title
    statusDetail.Text = detail
    statusDot.BackgroundColor3 = color or T.OFF
end

local function updateProgress(current, total)
    local frac = total > 0 and (current / total) or 0
    TweenService:Create(progressFill, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
        Size = UDim2.new(frac, 0, 1, 0)
    }):Play()
    progressText.Text = current .. " / " .. total .. " waypoints"
end

local function tweenTo(rootPart, targetPos, speed)
    local distance = (rootPart.Position - targetPos).Magnitude
    local duration = distance / speed
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = CFrame.new(targetPos)})
    tween:Play()
    tween.Completed:Wait()
    return tween
end

local function executeMovement()
    if state.running then return end
    state.running = true
    state.stopRequested = false
    state.currentWaypoint = 0

    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not rootPart then
        warn("Movement Script: No humanoid or root part found!")
        state.running = false
        return
    end

    setStatus("EN COURS", "Démarrage...", T.WHITE)
    showNotif(gui, "Movement", "Parcours démarré", "success")

    for i, waypoint in ipairs(MOVE_CONFIG.waypoints) do
        if state.stopRequested then
            setStatus("ARRÊTÉ", "Interrompu par l'utilisateur", T.DANGER)
            showNotif(gui, "Movement", "Parcours arrêté", "error")
            state.running = false
            return
        end

        state.currentWaypoint = i
        updateProgress(i - 1, state.totalWaypoints)
        setStatus("WAYPOINT " .. i .. "/" .. state.totalWaypoints, "En déplacement...", T.WHITE)

        -- Timer
        local startT = tick()
        local timerConn = RunService.Heartbeat:Connect(function()
            if not state.running then return end
            local elapsed = tick() - startT
            timerText.Text = string.format("%.1fs", elapsed)
        end)

        -- Move to waypoint
        tweenTo(rootPart, waypoint, MOVE_CONFIG.movementSpeed)

        -- Extra point after waypoint 1
        if i == 1 and not state.stopRequested then
            tweenTo(rootPart, MOVE_CONFIG.extraPointAfter1, MOVE_CONFIG.movementSpeed)
            task.wait(3)
        end

        -- Sit at waypoint 2
        if i == 2 and not state.stopRequested then
            humanoid.Sit = true
            setStatus("ASSIS", "Attente de 40s...", T.WARN)
            for sec = 40, 0, -1 do
                if state.stopRequested then break end
                setStatus("ASSIS", "Attente : " .. sec .. "s", T.WARN)
                task.wait(1)
            end
            humanoid.Sit = false
        end

        task.wait(0.1)
        timerConn:Disconnect()
    end

    updateProgress(state.totalWaypoints, state.totalWaypoints)

    if state.stopRequested then
        setStatus("ARRÊTÉ", "Interrompu", T.DANGER)
        showNotif(gui, "Movement", "Parcours arrêté", "error")
    else
        setStatus("TERMINÉ", "Parcours complet ✓", T.SUCCESS)
        showNotif(gui, "Movement", "Parcours terminé !", "success")
        print("you won")
    end

    state.running = false
end

startBtn.MouseButton1Click:Connect(function()
    if state.running then
        showNotif(gui, "Movement", "Déjà en cours", "warn")
        return
    end
    task.spawn(executeMovement)
end)

stopBtn.MouseButton1Click:Connect(function()
    if not state.running then
        showNotif(gui, "Movement", "Aucun parcours actif", "warn")
        return
    end
    state.stopRequested = true
    showNotif(gui, "Movement", "Arrêt demandé...", "warn")
end)

print("[Movement Script] ✅ UI chargée !")
