    stopBtn.Position = UDim2.new(0.5, 4, 0, 0)
    stopBtn.BackgroundColor3 = T.BG_DEEP
    stopBtn.BorderSizePixel = 0
    stopBtn.Text = "⏹  ARRÊTER"
    stopBtn.TextColor3 = T.DANGER
    stopBtn.Font = Enum.Font.GothamBlack
    stopBtn.TextSize = 12
    stopBtn.AutoButtonColor = false
    stopBtn.ZIndex = 4
    stopBtn.Parent = btnRow
    corner(stopBtn, 10)
    local stopStroke = Instance.new("UIStroke")
    stopStroke.Color = T.DANGER
    stopStroke.Thickness = 1.2
    stopStroke.Transparency = 0.5
    stopStroke.Parent = stopBtn

    startBtn.MouseEnter:Connect(function()
        TweenService:Create(startBtn, F, {BackgroundColor3 = Color3.fromRGB(220, 220, 220)}):Play()
    end)
    startBtn.MouseLeave:Connect(function()
        TweenService:Create(startBtn, F, {BackgroundColor3 = T.WHITE}):Play()
    end)
    stopBtn.MouseEnter:Connect(function()
        TweenService:Create(stopBtn, F, {BackgroundColor3 = T.CARD_HOV}):Play()
        TweenService:Create(stopStroke, F, {Transparency = 0}):Play()
    end)
    stopBtn.MouseLeave:Connect(function()
        TweenService:Create(stopBtn, F, {BackgroundColor3 = T.BG_DEEP}):Play()
        TweenService:Create(stopStroke, F, {Transparency = 0.5}):Play()
    end)

    -- ═══ DRAG ═══
    local dragging, dragStart, startPos
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = panel.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            panel.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- ═══ HIDE/EXPAND ═══
    local uiVisible = true
    hideBtn.MouseButton1Click:Connect(function()
        uiVisible = not uiVisible
        if uiVisible then
            hideBtn.Text = "−"
            TweenService:Create(panel, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 280, 0, 260)
            }):Play()
        else
            hideBtn.Text = "+"
            TweenService:Create(panel, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 280, 0, 38)
            }):Play()
        end
    end)

    -- Animation entrée
    task.spawn(function()
        task.wait(1.4)
        TweenService:Create(panel, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(1, -295, 0.5, -130)
        }):Play()
    end)

    return screenGui, panel, startBtn, stopBtn, statusDot, statusTitle, statusDetail, progressFill, progressText, timerText
end

