-- 🖤🤍 PALETTE NOIR & BLANC
-- ═══════════════════════════════════════════════
local T = {
    BG       = Color3.fromRGB(0, 0, 0),
    BG_DEEP  = Color3.fromRGB(8, 8, 8),
    CARD     = Color3.fromRGB(15, 15, 15),
    CARD_HOV = Color3.fromRGB(30, 30, 30),
    LINE     = Color3.fromRGB(255, 255, 255),
    TEXT     = Color3.fromRGB(255, 255, 255),
    TEXT_DIM = Color3.fromRGB(160, 160, 160),
    WHITE    = Color3.fromRGB(255, 255, 255),
    BLACK    = Color3.fromRGB(0, 0, 0),
    SUCCESS  = Color3.fromRGB(100, 255, 160),
    DANGER   = Color3.fromRGB(255, 90, 90),
    WARN     = Color3.fromRGB(255, 190, 60),
    OFF      = Color3.fromRGB(80, 80, 80),
}

local GRADIENT_SEQ = ColorSequence.new({
    ColorSequenceKeypoint.new(0.00, Color3.fromRGB(60, 60, 60)),
    ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 255, 255)),
    ColorSequenceKeypoint.new(0.50, Color3.fromRGB(180, 180, 180)),
    ColorSequenceKeypoint.new(0.75, Color3.fromRGB(255, 255, 255)),
    ColorSequenceKeypoint.new(1.00, Color3.fromRGB(60, 60, 60)),
})

local F = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- Liste globale des gradients animés
local animatedGradients = {}

local function registerGradient(grad, speed)
    table.insert(animatedGradients, {grad = grad, speed = speed or 90})
end

task.spawn(function()
    while task.wait(0.05) do
        for i = #animatedGradients, 1, -1 do
            local entry = animatedGradients[i]
            if entry.grad and entry.grad.Parent then
                entry.grad.Rotation = (entry.grad.Rotation + entry.speed * 0.05) % 360
            else
                table.remove(animatedGradients, i)
            end
        end
    end
end)

-- ═══════════════════════════════════════════════
-- 🛠️ HELPERS UI
-- ═══════════════════════════════════════════════
local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 10)
    c.Parent = parent
    return c
end

local function strokeAnim(parent, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Thickness = thickness or 1.5
    s.Transparency = transparency or 0
    s.Color = T.LINE
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    local g = Instance.new("UIGradient")
    g.Color = GRADIENT_SEQ
    g.Rotation = 0
    g.Parent = s
    registerGradient(g, 120)
    return s, g
end

local function addShimmer(frame, speed)
    speed = speed or 2.5
    local shimmer = Instance.new("Frame")
    shimmer.Name = "Shimmer"
    shimmer.Size = UDim2.new(0, 60, 1, 0)
    shimmer.Position = UDim2.new(-0.3, 0, 0, 0)
    shimmer.BackgroundColor3 = T.WHITE
    shimmer.BackgroundTransparency = 0.92
    shimmer.BorderSizePixel = 0
    shimmer.ZIndex = 2
    shimmer.Parent = frame
    corner(shimmer, 20)
    task.spawn(function()
        while shimmer and shimmer.Parent do
            shimmer.Position = UDim2.new(-0.3, 0, 0, 0)
            TweenService:Create(shimmer, TweenInfo.new(speed, Enum.EasingStyle.Linear), {
                Position = UDim2.new(1.1, 0, 0, 0)
            }):Play()
            task.wait(speed + 1.5)
        end
    end)
end

