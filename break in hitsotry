local notifContainer = nil
local notifParentGui = nil
local notifOrder = 0

local function showNotif(title, message, notifType)
    if not Settings.notifications then return end
    if not notifParentGui then return end
    notifType = notifType or "info"
    notifOrder = notifOrder + 1

    if not notifContainer or not notifContainer.Parent then
        notifContainer = Instance.new("Frame")
        notifContainer.Size = UDim2.new(0, 320, 1, -40)
        notifContainer.Position = UDim2.new(0.5, -160, 0, 20)
        notifContainer.BackgroundTransparency = 1
        notifContainer.ZIndex = 999999
        notifContainer.Parent = notifParentGui
        local l = Instance.new("UIListLayout")
        l.Padding = UDim.new(0, 6)
        l.SortOrder = Enum.SortOrder.LayoutOrder
        l.HorizontalAlignment = Enum.HorizontalAlignment.Center
        l.VerticalAlignment = Enum.VerticalAlignment.Top
        l.Parent = notifContainer
    end

    local accentColor
    if notifType == "success" then accentColor = T.SUCCESS
    elseif notifType == "error" then accentColor = T.DANGER
    elseif notifType == "warn" then accentColor = T.WARN
    else accentColor = T.PRIMARY end

    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, 320, 0, 50)
    notif.BackgroundColor3 = T.BG_DEEP
    notif.BackgroundTransparency = 0.05
    notif.BorderSizePixel = 0
    notif.Position = UDim2.new(0, 0, 0, -70)
    notif.LayoutOrder = notifOrder
    notif.ZIndex = 1000000
    notif.Parent = notifContainer

    makeDripGradient(notif, {
        ColorSequenceKeypoint.new(0.00, T.BG_DEEP),
        ColorSequenceKeypoint.new(0.50, T.CARD),
        ColorSequenceKeypoint.new(1.00, T.BG_DEEP),
    }, 1)

    local nStroke = Instance.new("UIStroke")
    nStroke.Color = accentColor
    nStroke.Thickness = 1.5
    nStroke.Transparency = 0.3
    nStroke.Parent = notif

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 4, 1, -12)
    bar.Position = UDim2.new(0, 6, 0, 6)
    bar.BackgroundColor3 = accentColor
    bar.BorderSizePixel = 0
    bar.Parent = notif

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1, -30, 0, 18)
    titleLbl.Position = UDim2.new(0, 20, 0, 8)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = title
    titleLbl.TextColor3 = accentColor
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 12
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Parent = notif

    local msgLbl = Instance.new("TextLabel")
    msgLbl.Size = UDim2.new(1, -30, 0, 14)
    msgLbl.Position = UDim2.new(0, 20, 0, 26)
    msgLbl.BackgroundTransparency = 1
    msgLbl.Text = message
    msgLbl.TextColor3 = T.TEXT_DIM
    msgLbl.Font = Enum.Font.Gotham
    msgLbl.TextSize = 10
    msgLbl.TextXAlignment = Enum.TextXAlignment.Left
    msgLbl.TextTruncate = Enum.TextTruncate.AtEnd
    msgLbl.Parent = notif

    TweenService:Create(notif, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0)
    }):Play()

    task.delay(Settings.notifDuration, function()
        if notif and notif.Parent then
            TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Position = UDim2.new(0, 0, 0, -70),
                BackgroundTransparency = 1,
            }):Play()
            task.wait(0.35)
            if notif and notif.Parent then notif:Destroy() end
        end
    end)
end

-- ═══════════════════════════════════════════════
-- 🎯 EXÉCUTION D'UN BOUTON
-- ═══════════════════════════════════════════════
local function executeAction(scriptData)
    if not scriptData or not scriptData.action then
        showNotif("Erreur", "Pas d'action définie", "error")
        return
    end

    showNotif("Loading", "Loading " .. scriptData.name, "info")

    task.spawn(function()
        local ok, err = pcall(scriptData.action)
        if ok then
            showNotif("Succès", scriptData.name .. " exécuté", "success")
        else
            showNotif("Erreur", tostring(err):sub(1, 60), "error")
        end
    end)
end

