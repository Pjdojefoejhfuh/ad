    sliderDownFill.Size = UDim2.new(CONFIG.MAGNET_FORCE_DOWN / 5000, 0, 1, 0)
    sliderDownFill.BackgroundColor3 = T.WHITE
    sliderDownFill.BorderSizePixel = 0
    sliderDownFill.ZIndex = 4
    sliderDownFill.Parent = sliderDownBg
    corner(sliderDownFill, 999)

    local downFillGrad = Instance.new("UIGradient")
    downFillGrad.Color = GRADIENT_SEQ
    downFillGrad.Rotation = 0
    downFillGrad.Parent = sliderDownFill
    registerGradient(downFillGrad, 120)

    local sliderDownBtn = Instance.new("TextButton")
    sliderDownBtn.Size = UDim2.new(1, 0, 1, 0)
    sliderDownBtn.BackgroundTransparency = 1
    sliderDownBtn.Text = ""
    sliderDownBtn.ZIndex = 5
    sliderDownBtn.Parent = sliderDownBg

    -- Logique slider
    local function makeSlider(sliderBg, fill, label, labelPrefix, maxVal, configKey)
        local draggingSlider = false
        sliderBg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = true
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
                local absPos = sliderBg.AbsolutePosition
                local absSize = sliderBg.AbsoluteSize
                local relX = math.clamp((input.Position.X - absPos.X) / absSize.X, 0, 1)
                local newVal = math.floor(relX * maxVal)
                CONFIG[configKey] = newVal
                fill.Size = UDim2.new(relX, 0, 1, 0)
                label.Text = labelPrefix .. newVal
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = false
            end
        end)
    end

    makeSlider(sliderNormalBg, sliderNormalFill, labelNormal, "Force normale : ", 5000, "MAGNET_FORCE")
    makeSlider(sliderDownBg, sliderDownFill, labelDown, "Force pente : ", 5000, "MAGNET_FORCE_DOWN")

    -- Onglets
    local function switchTab(tab)
        state.currentTab = tab
        if tab == "main" then
            pageMain.Visible = true
            pageForces.Visible = false
            TweenService:Create(tabMain, F, {
                BackgroundColor3 = T.WHITE,
                BackgroundTransparency = 0.1,
            }):Play()
            tabMain.TextColor3 = T.BLACK
            tabMain.Font = Enum.Font.GothamBlack
            TweenService:Create(tabForces, F, {
                BackgroundColor3 = T.BLACK,
                BackgroundTransparency = 0.7,
            }):Play()
            tabForces.TextColor3 = T.TEXT_DIM
            tabForces.Font = Enum.Font.Gotham
        else
            pageMain.Visible = false
            pageForces.Visible = true
            TweenService:Create(tabForces, F, {
                BackgroundColor3 = T.WHITE,
                BackgroundTransparency = 0.1,
            }):Play()
            tabForces.TextColor3 = T.BLACK
            tabForces.Font = Enum.Font.GothamBlack
            TweenService:Create(tabMain, F, {
                BackgroundColor3 = T.BLACK,
                BackgroundTransparency = 0.7,
            }):Play()
            tabMain.TextColor3 = T.TEXT_DIM
            tabMain.Font = Enum.Font.Gotham
        end
    end

    tabMain.MouseButton1Click:Connect(function() switchTab("main") end)
    tabForces.MouseButton1Click:Connect(function() switchTab("forces") end)

    -- Animation entrée
    task.spawn(function()
        task.wait(1.4)
        TweenService:Create(panel, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(1, -255, 0, 80)
        }):Play()
    end)

    -- Drag
    local dragging, dragStart, startPos
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = panel.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            panel.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    hideBtn.MouseButton1Click:Connect(function()
        state.uiVisible = not state.uiVisible
        if state.uiVisible then
            hideBtn.Text = "−"
            panel.ClipsDescendants = true
            TweenService:Create(panel, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 240, 0, 210)
            }):Play()
        else
            hideBtn.Text = "+"
            TweenService:Create(panel, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 240, 0, 38)
            }):Play()
        end
    end)

    toggleBtn.MouseEnter:Connect(function()
        TweenService:Create(toggleBtn, F, {BackgroundColor3 = T.CARD_HOV}):Play()
    end)
    toggleBtn.MouseLeave:Connect(function()
        TweenService:Create(toggleBtn, F, {BackgroundColor3 = T.CARD}):Play()
    end)

    return screenGui, toggleBtn, cartInfo, btnLabel, btnStroke, led
end

