-- 🧲 STABILISATEUR
-- ═══════════════════════════════════════════════
local function cleanup()
    if state.heartbeatConn then
        state.heartbeatConn:Disconnect()
        state.heartbeatConn = nil
    end
    for _, vf in ipairs(state.allVF or {}) do
        if vf.Parent then vf:Destroy() end
    end
    state.allVF = {}
    state.currentCart = nil
end

local function getWheels(cart)
    local wheels = {}
    local keywords = {"wheel", "roue", "tire", "axle", "roda", "tyre", "pneu"}
    for _, v in ipairs(cart:GetDescendants()) do
        if v:IsA("BasePart") and not v.Anchored then
            local name = v.Name:lower()
            for _, kw in ipairs(keywords) do
                if name:find(kw) then
                    table.insert(wheels, v)
                    break
                end
            end
        end
    end
    if #wheels == 0 then
        local allParts = {}
        for _, v in ipairs(cart:GetDescendants()) do
            if v:IsA("BasePart") and not v.Anchored then
                table.insert(allParts, v)
            end
        end
        if cart.PrimaryPart then table.insert(allParts, cart.PrimaryPart) end
        table.sort(allParts, function(a, b) return a.Position.Y < b.Position.Y end)
        local count = math.max(1, math.floor(#allParts / 3))
        for i = 1, count do table.insert(wheels, allParts[i]) end
    end
    return wheels
end

local function applyStabilizer(cart)
    if not cart then return end
    local wheels = getWheels(cart)
    if #wheels == 0 then return end

    state.currentCart = cart
    state.allVF = {}

    for _, part in ipairs(wheels) do
        local att = part:FindFirstChild("_StabVFAtt")
        if not att then
            att = Instance.new("Attachment")
            att.Name = "_StabVFAtt"
            att.Parent = part
        end
        local vf = Instance.new("VectorForce")
        vf.Attachment0 = att
        vf.RelativeTo = Enum.ActuatorRelativeTo.World
        vf.Force = Vector3.new(0, 0, 0)
        vf.Parent = part
        table.insert(state.allVF, vf)
    end

    local refPart = cart.PrimaryPart or wheels[1]

    state.heartbeatConn = RunService.Heartbeat:Connect(function()
        if not refPart or not refPart.Parent then cleanup() return end

        local forceMag = 0
        if state.enabled then
            local velY = refPart.AssemblyLinearVelocity.Y
            if math.abs(velY) > 5 then
                forceMag = CONFIG.MAGNET_FORCE_DOWN
            else
                forceMag = CONFIG.MAGNET_FORCE
            end
        end

        for _, vf in ipairs(state.allVF) do
            if vf.Parent then
                vf.Force = Vector3.new(0, -forceMag * vf.Parent.AssemblyMass, 0)
            end
        end
    end)
end

local function findCartFromSeat(seat)
    local current = seat.Parent
    while current and current ~= workspace do
        if current:IsA("Model") then return current end
        current = current.Parent
    end
    return nil
end

local function onSeatChanged(seat)
    cleanup()
    if not seat then return end
    local cart = findCartFromSeat(seat)
    if not cart then return end
    if state.enabled then applyStabilizer(cart) else state.currentCart = cart end
end

local function watchSeats()
    humanoid.Seated:Connect(function(isSeated, seat)
        if isSeated and seat then onSeatChanged(seat) else onSeatChanged(nil) end
    end)
end

local screenGui, toggleBtn, cartInfo, btnLabel, btnStroke, led = createUI()

RunService.Heartbeat:Connect(function()
    if state.currentCart and state.currentCart.Parent then
        cartInfo.Text = "🛒 " .. state.currentCart.Name
        cartInfo.TextColor3 = Color3.fromRGB(100, 255, 160)
    else
        cartInfo.Text = "Assieds-toi sur un cart"
        cartInfo.TextColor3 = T.TEXT_DIM
    end
end)

toggleBtn.MouseButton1Click:Connect(function()
    state.enabled = not state.enabled
    if state.enabled then
        btnLabel.Text = "STABILISATEUR : ON"
        btnLabel.TextColor3 = T.WHITE
        led.BackgroundColor3 = T.WHITE
        btnStroke.Color = T.WHITE
        if btnStrokeGrad then btnStrokeGrad.Color = GRADIENT_SEQ end
        if state.currentCart and state.currentCart.Parent then
            applyStabilizer(state.currentCart)
        end
        showNotif(screenGui, "Cart Stabilizer", "Activé", "success")
    else
        btnLabel.Text = "STABILISATEUR : OFF"
        btnLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
        led.BackgroundColor3 = Color3.fromRGB(255, 90, 90)
        btnStroke.Color = Color3.fromRGB(255, 90, 90)
        if btnStrokeGrad then
            btnStrokeGrad.Color = ColorSequence.new(Color3.fromRGB(255, 90, 90))
        end
        for _, vf in ipairs(state.allVF) do
            if vf.Parent then vf.Force = Vector3.new(0, 0, 0) end
        end
        showNotif(screenGui, "Cart Stabilizer", "Désactivé", "error")
    end
end)

