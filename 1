        if writefile then writefile("OutfitStealer_Avatars.json", HttpService:JSONEncode(SavedAvatars)) end
    end)
end

local function serializeDesc(d, plr)
    if not d or not d:IsA("HumanoidDescription") then return nil end
    local data = dict(d)
    data._meta = {
        name = plr and plr.Name or "?",
        userId = plr and plr.UserId or 0,
        displayName = plr and plr.DisplayName or "?",
        savedAt = os.time(),
        savedDate = os.date("%d/%m/%Y %H:%M:%S"),
    }
    return data
end

-- ⭐ FORWARD DECLARATION pour éviter le "attempt to call nil value"
local updateAvatarCount

local function saveAvatar(targetPlayer, desc)
    if not Settings.autoSaveAvatar then return end
    if not targetPlayer or not desc then return end
    local data = serializeDesc(desc, targetPlayer)
    if not data then return end
    local key = tostring(targetPlayer.UserId)
    local wasExisting = SavedAvatars[key] ~= nil
    SavedAvatars[key] = data
    saveAvatarFile()
    showNotif("Avatar", "@" .. targetPlayer.Name .. (wasExisting and " (maj)" or " sauvegarde"), "success")
    if updateAvatarCount then updateAvatarCount() end
end

local function loadAvatar(userId)
    local data = SavedAvatars[tostring(userId)]
    if not data then
        showNotif("Avatar", "Avatar introuvable", "error")
        return
    end
    local newDesc = Instance.new("HumanoidDescription")
    pcall(function()
        for k, v in pairs(data) do
            if k ~= "_meta" and k ~= "LayeredAccessories" and k ~= "MakeupItems" and k ~= "AccessoryRefinements" then
                pcall(function() newDesc[k] = v end)
            end
        end
    end)
    local myHum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    if myHum then
        myHum:ApplyDescription(newDesc)
        showNotif("Avatar", "Avatar " .. (data._meta.name or "?") .. " applique", "success")
    end
end

-- ⭐ Défini APRÈS la forward declaration
updateAvatarCount = function()
    if Runtime.avatarCount then
        local n = 0
        for _ in pairs(SavedAvatars) do n = n + 1 end
        Runtime.avatarCount.Text = "Avatars sauvegardes : " .. n
    end
end

