-- REFRESH PROMPTS
-- ═══════════════════════════════════════════════
function refreshPromptList()
    if Runtime.fullyClosed then return end
    if not Runtime.promptCount then return end
    local count = 0
    for _ in pairs(PromptSystem.prompts) do count = count + 1 end
    Runtime.promptCount.Text = "ProximityPrompt actifs : " .. count
    if Runtime.statusDetail then
        local total = (Runtime.injected.view and 1 or 0) + (Runtime.injected.steal and 1 or 0)
        Runtime.statusDetail.Text = "Boutons : " .. total .. "/2 · Prompts : " .. count
    end
end

function refreshAllPrompts()
    if Runtime.fullyClosed then return end
    for plr, _ in pairs(PromptSystem.prompts) do
        removePromptForPlayer(plr)
    end
    if not PromptSystem.enabled then return end
    for _, plr in ipairs(players:GetPlayers()) do
        if plr ~= lp then createPromptForPlayer(plr) end
    end
end

