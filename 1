-- MODE SPAM (avec fonction TP directe qui marche)
-- ═══════════════════════════════════════════════
local SpamMode = {
    running = false,
    copiedPlayers = {},
    thread = nil,
}

-- TP simple comme ta fonction originale
local function tpToPlayer(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return false end
    local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return false end

    local character = lp.Character
    if not character then return false end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end

    pcall(function()
        rootPart.CFrame = targetRoot.CFrame + Vector3.new(0, 3, 0)
    end)

    task.wait()
    pcall(function()
        if rootPart.Parent and targetRoot.Parent then
            rootPart.CFrame = targetRoot.CFrame + Vector3.new(0, 3, 0)
        end
    end)

    return true
end

local function copyAvatarFromPlayer(targetPlayer)
    if not targetPlayer then return false end
    local desc, rig = descfrom(targetPlayer)
    if not desc then
        showNotif("Copy", "Impossible de recuperer @" .. targetPlayer.Name, "error")
        return false
    end
    go(desc, nil, rig)
    saveAvatar(targetPlayer, desc)
    local avatar = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. targetPlayer.UserId .. "&width=150&height=150&format=png"
    addToHistory(targetPlayer.Name, targetPlayer.UserId, avatar)
    return true
end

local function startSpamMode()
    if SpamMode.running then
        showNotif("Spam", "Deja en cours", "warn")
        return
    end
    SpamMode.running = true
    SpamMode.copiedPlayers = {}
    showNotif("Spam Mode", "Demarrage TP + copy...", "success")
    if Runtime.spamBtn then
        Runtime.spamBtn.Text = "STOP SPAM"
        Runtime.spamBtn.BackgroundColor3 = T.DANGER
        Runtime.spamBtn.TextColor3 = T.WHITE
    end

    SpamMode.thread = task.spawn(function()
        local copied = 0
        local failed = 0

        while SpamMode.running do
            local toCopy = {}
            for _, plr in ipairs(players:GetPlayers()) do
                if plr ~= lp and not SpamMode.copiedPlayers[tostring(plr.UserId)] then
                    table.insert(toCopy, plr)
                end
            end

            if #toCopy == 0 then
                showNotif("Spam Mode", "Termine - " .. copied .. " copies", "success")
                break
            end

            local plr = toCopy[1]

            if not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then
                SpamMode.copiedPlayers[tostring(plr.UserId)] = true
                failed = failed + 1
                task.wait(0.2)
                continue
            end

            local tpOk = tpToPlayer(plr)
            if not tpOk then
                SpamMode.copiedPlayers[tostring(plr.UserId)] = true
                failed = failed + 1
                task.wait(0.3)
                continue
            end

            showNotif("TP", "TP vers @" .. plr.Name, "info")

            -- Reste collé 2 secondes
            local stayStart = tick()
            while tick() - stayStart < 2 do
                if not SpamMode.running then break end
                if not plr.Character then break end

                local targetRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                if targetRoot and myRoot then
                    pcall(function()
                        myRoot.CFrame = targetRoot.CFrame + Vector3.new(0, 3, 0)
                    end)
                end
                task.wait(0.05)
            end

            if not SpamMode.running then break end

            local ok = copyAvatarFromPlayer(plr)
            if ok then
                copied = copied + 1
                showNotif("Copy", "@" .. plr.Name .. " (" .. copied .. ")", "success")
            else
                failed = failed + 1
            end

            SpamMode.copiedPlayers[tostring(plr.UserId)] = true
            task.wait(Settings.spamTPDelay)
        end

        SpamMode.running = false
        if Runtime.spamBtn then
            Runtime.spamBtn.Text = "SPAM TP + COPY"
            Runtime.spamBtn.BackgroundColor3 = T.WHITE
            Runtime.spamBtn.TextColor3 = T.BLACK
        end
    end)
end

local function stopSpamMode()
    SpamMode.running = false
    if SpamMode.thread then
        pcall(function() task.cancel(SpamMode.thread) end)
        SpamMode.thread = nil
    end
    showNotif("Spam Mode", "Arrete", "warn")
    if Runtime.spamBtn then
        Runtime.spamBtn.Text = "SPAM TP + COPY"
        Runtime.spamBtn.BackgroundColor3 = T.WHITE
        Runtime.spamBtn.TextColor3 = T.BLACK
    end
end

