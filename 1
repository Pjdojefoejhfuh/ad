-- ═══════════════════════════════════════════════
local function stealFromPlayer(targetPlayer)
    if not targetPlayer or targetPlayer == lp then
        showNotif("Steal", "Cible invalide", "error")
        return
    end
    local desc, rig = descfrom(targetPlayer)
    if not desc then
        showNotif("Steal", "Impossible de recuperer @" .. targetPlayer.Name, "error")
        return
    end
    go(desc, nil, rig)
    saveAvatar(targetPlayer, desc)
    local avatar = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. targetPlayer.UserId .. "&width=150&height=150&format=png"
    addToHistory(targetPlayer.Name, targetPlayer.UserId, avatar)
    showNotif("Steal", "Outfit vole de @" .. targetPlayer.Name, "success")
    if Settings.autoViewAfterSteal then
        task.wait(0.3)
        view(targetPlayer, desc)
    end
end

