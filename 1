-- PROXIMITY PROMPT SYSTEM (FIX pour joueurs qui rejoignent)
-- ═══════════════════════════════════════════════
local PromptSystem = {
    prompts = {},
    enabled = Settings.proximityEnabled,
    charConns = {},
    playerConns = {},
    scannerThread = nil,
}

local function removePromptForPlayer(plr)
    local data = PromptSystem.prompts[plr]
    if not data then return end
    if data.conn then pcall(function() data.conn:Disconnect() end) end
    if data.prompt and data.prompt.Parent then pcall(function() data.prompt:Destroy() end) end
    if data.highlight and data.highlight.Parent then pcall(function() data.highlight:Destroy() end) end
    if data.att and data.att.Parent then pcall(function() data.att:Destroy() end) end
    PromptSystem.prompts[plr] = nil
end

local function removeAllPrompts()
    for plr, _ in pairs(PromptSystem.prompts) do
        removePromptForPlayer(plr)
    end
    for plr, conn in pairs(PromptSystem.charConns) do
        pcall(function() conn:Disconnect() end)
    end
    PromptSystem.charConns = {}
    for _, conn in pairs(PromptSystem.playerConns) do
        pcall(function() conn:Disconnect() end)
    end
    PromptSystem.playerConns = {}
    if PromptSystem.scannerThread then
        pcall(function() task.cancel(PromptSystem.scannerThread) end)
        PromptSystem.scannerThread = nil
    end
end

local function createPromptForPlayer(plr)
    if not plr or plr == lp then return end
    if not PromptSystem.enabled then return end

    removePromptForPlayer(plr)

    local char = plr.Character
    if not char then
        local timeout = 0
        repeat
            task.wait(0.2)
            char = plr.Character
            timeout = timeout + 0.2
        until char or timeout > 10
    end
    if not char then return end

    local torso = char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("LowerTorso")
        or char:FindFirstChild("HumanoidRootPart")
    if not torso then
        local t = 0
        repeat
            task.wait(0.2)
            torso = char:FindFirstChild("UpperTorso")
                or char:FindFirstChild("Torso")
                or char:FindFirstChild("LowerTorso")
                or char:FindFirstChild("HumanoidRootPart")
            t = t + 0.2
        until torso or t > 5
    end
    if not torso then return end

    if plr.Character ~= char then return end

    local att = Instance.new("Attachment")
    att.Name = "NovaStealAtt"
    att.Parent = torso

    local prompt = Instance.new("ProximityPrompt")
    prompt.Name = "NovaStealPrompt"
    prompt.ActionText = "STEAL OUTFIT"
    prompt.ObjectText = "@" .. plr.Name
    prompt.KeyboardKeyCode = Enum.KeyCode[Settings.proximityKey] or Enum.KeyCode.E
    prompt.HoldDuration = Settings.proximityHoldTime or 0.3
    prompt.MaxActivationDistance = Settings.proximityRange or 12
    prompt.RequiresLineOfSight = false
    prompt.Style = Enum.ProximityPromptStyle.Default
    prompt.Parent = att

    local highlight
    if Settings.proximityHighlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "NovaStealHighlight"
        highlight.Adornee = char
        highlight.FillColor = T.WHITE
        highlight.OutlineColor = T.WHITE
        highlight.FillTransparency = 0.85
        highlight.OutlineTransparency = 0.4
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = char
    end

    local conn = prompt.Triggered:Connect(function(triggerPlayer)
        if triggerPlayer ~= lp then return end
        if not PromptSystem.enabled then return end
        stealFromPlayer(plr)
    end)

    PromptSystem.prompts[plr] = {
        prompt = prompt, highlight = highlight, conn = conn,
        att = att, torso = torso, char = char,
    }
end

local function watchPlayer(plr)
    if not plr or plr == lp then return end
    if plr.Character then
        task.spawn(function()
            createPromptForPlayer(plr)
        end)
    end
    if PromptSystem.charConns[plr] then
        pcall(function() PromptSystem.charConns[plr]:Disconnect() end)
    end
    PromptSystem.charConns[plr] = plr.CharacterAdded:Connect(function(char)
        task.wait(1.2)
        if PromptSystem.enabled then
            createPromptForPlayer(plr)
        end
    end)
end

local function setupPromptSystem()
    for _, plr in ipairs(players:GetPlayers()) do
        watchPlayer(plr)
    end

    table.insert(PromptSystem.playerConns, players.PlayerAdded:Connect(function(plr)
        watchPlayer(plr)
        plr.CharacterAdded:Connect(function(char)
            task.wait(1.5)
            if PromptSystem.enabled and not PromptSystem.prompts[plr] then
                createPromptForPlayer(plr)
            end
        end)
    end))

    table.insert(PromptSystem.playerConns, players.PlayerRemoving:Connect(function(plr)
        removePromptForPlayer(plr)
        if PromptSystem.charConns[plr] then
            pcall(function() PromptSystem.charConns[plr]:Disconnect() end)
            PromptSystem.charConns[plr] = nil
        end
    end))

    PromptSystem.scannerThread = task.spawn(function()
        while PromptSystem.scannerThread do
            task.wait(1)
            if not PromptSystem.enabled then continue end
            for _, plr in ipairs(players:GetPlayers()) do
                if plr ~= lp then
                    local data = PromptSystem.prompts[plr]
                    local needsPrompt = false
                    if not data then needsPrompt = true
                    elseif not data.prompt or not data.prompt.Parent then needsPrompt = true
                    elseif data.char and plr.Character and data.char ~= plr.Character then needsPrompt = true
                    elseif plr.Character and data.torso and data.torso.Parent ~= plr.Character then needsPrompt = true end
                    if needsPrompt then createPromptForPlayer(plr) end
                end
            end
        end
    end)
end

