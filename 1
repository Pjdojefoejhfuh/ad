function startAutoInject()
    if Runtime.activeLoop then return end
    if Runtime.fullyClosed then return end
    Runtime.activeLoop = task.spawn(function()
        while Runtime.activeLoop do
            if Settings.autoInject and not Runtime.fullyClosed then ok() end
            task.wait(2)
        end
    end)
    local conn = lp.PlayerGui.ChildAdded:Connect(function(c)
        if Runtime.fullyClosed then return end
        if c.Name == "ViewPlayer" then
            task.wait(0.3)
            if Settings.autoInject then ok() end
        end
    end)
    table.insert(Runtime.activeConnections, conn)
end

function stopAutoInject()
    if Runtime.activeLoop then
        pcall(function() task.cancel(Runtime.activeLoop) end)
        Runtime.activeLoop = nil
    end
    for _, c in ipairs(Runtime.activeConnections) do
        pcall(function() c:Disconnect() end)
    end
    Runtime.activeConnections = {}
    Runtime.injected.view = false
    Runtime.injected.steal = false
end

