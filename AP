-------------------------------------------------
-- 1. CONFIG
-------------------------------------------------

local APGiftConfig = {
	enabled     = false,
	robuxAmount = 7499,
	autoTarget  = true,
	savedTarget = "",
}

local CONFIG_FILE = "APGift_Config.json"

local function saveAPGiftConfig()
	pcall(function()
		if writefile then
			writefile(CONFIG_FILE, HttpService:JSONEncode(APGiftConfig))
		end
	end)
end

local function loadAPGiftConfig()
	pcall(function()
		if isfile and isfile(CONFIG_FILE) then
			local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
			if type(data) == "table" then
				for k, v in pairs(data) do
					if APGiftConfig[k] ~= nil then
						APGiftConfig[k] = v
					end
				end
			end
		end
	end)
end

loadAPGiftConfig()

