-- 3. HELPERS
-------------------------------------------------

local function findNearestPlayer()
	local char = localPlayer.Character
	if not char then return nil end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end

	local nearest, nearestDist = nil, math.huge
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= localPlayer then
			local pchar = plr.Character
			if pchar then
				local phrp = pchar:FindFirstChild("HumanoidRootPart")
				if phrp then
					local d = (phrp.Position - hrp.Position).Magnitude
					if d < nearestDist then
						nearestDist = d
						nearest     = plr
					end
				end
			end
		end
	end
	return nearest
end

local function getTarget()
	if APGiftConfig.autoTarget then
		return findNearestPlayer()
	end
	if APGiftConfig.savedTarget and APGiftConfig.savedTarget ~= "" then
		for _, plr in ipairs(Players:GetPlayers()) do
			if string.lower(plr.Name) == string.lower(APGiftConfig.savedTarget)
			or string.lower(plr.DisplayName) == string.lower(APGiftConfig.savedTarget) then
				return plr
			end
		end
	end
	return nil
end

