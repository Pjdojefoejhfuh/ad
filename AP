-- ─────────────────────────────────────────────
-- INPUT ROBUX — capture au focus perdu / Entrée
-- ─────────────────────────────────────────────

local robuxInput = Skibidi.CreateTextInput(tabMain, {
	Label       = "Robux",
	Placeholder = "ex: 7499",
	Default     = tostring(APGiftConfig.robuxAmount),
	Icon        = "coins",
})

-- Fonction pour appliquer la valeur du TextBox
local function applyRobuxFromBox()
	local box = nil
	if robuxInput then
		box = robuxInput.TextBox or robuxInput.Frame or robuxInput
		-- essaie plusieurs noms possibles
		if robuxInput.TextBox then box = robuxInput.TextBox
		elseif robuxInput.Frame and robuxInput.Frame:FindFirstChildOfClass("TextBox") then
			box = robuxInput.Frame:FindFirstChildOfClass("TextBox")
		elseif robuxInput.Frame then
			box = robuxInput.Frame:FindFirstChildWhichIsA("TextBox", true)
		end
	end
	if not box or not box:IsA("TextBox") then return end

	local num = tonumber((box.Text or ""):gsub("[^%d]", ""))
	if num and num > 0 then
		APGiftConfig.robuxAmount = math.floor(num)
		saveAPGiftConfig()
		print("[AP Gift] Robux = " .. APGiftConfig.robuxAmount)
	end
end

-- Hook sur le TextBox dès qu'il est dispo
task.spawn(function()
	task.wait(0.5)
	local box = nil
	if robuxInput then
		if robuxInput.TextBox then box = robuxInput.TextBox
		elseif robuxInput.Frame then
			box = robuxInput.Frame:FindFirstChildWhichIsA("TextBox", true)
		end
	end
	if box and box:IsA("TextBox") then
		-- Capture à chaque changement de texte
		box:GetPropertyChangedSignal("Text"):Connect(function()
			local num = tonumber((box.Text or ""):gsub("[^%d]", ""))
			if num and num > 0 then
				APGiftConfig.robuxAmount = math.floor(num)
			end
		end)
		-- Capture à la perte de focus
		box.FocusLost:Connect(function(enterPressed)
			applyRobuxFromBox()
		end)
		-- Capture Entrée
		box:GetPropertyChangedSignal("Text"):Connect(function() end)
		UserInputService.InputBegan:Connect(function(input, gpe)
			if gpe then return end
			if input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter then
				if box:IsFocused() then
					applyRobuxFromBox()
				end
			end
		end)
	end
end)

