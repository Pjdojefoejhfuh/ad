-- ═══ DRAG (sur le drag handle) ═══
local dragging, dragStart, startPos = false, nil, nil

dragHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = Vector2.new(input.Position.X, input.Position.Y)
        startPos = frame.Position
        TweenService:Create(st, TweenInfo.new(0.2), { Thickness = 3, Transparency = 0 }):Play()
        TweenService:Create(dhStroke, TweenInfo.new(0.2), { Thickness = 2.5, Transparency = 0 }):Play()
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                TweenService:Create(st, TweenInfo.new(0.3), { Thickness = 2, Transparency = 0.2 }):Play()
                TweenService:Create(dhStroke, TweenInfo.new(0.3), { Thickness = 1.5, Transparency = 0.4 }):Play()
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

-- ═══ TRI DES PACKS ═══
local ADIDAS_TOP_ORDER = { "Adidas Sports", "Adidas Community", "Adidas Aura" }
local adidasRank = {}
for i, n in ipairs(ADIDAS_TOP_ORDER) do adidasRank[n] = i end

local allNames = {}
for name in pairs(PACKS) do table.insert(allNames, name) end

table.sort(allNames, function(a, b)
    local ra, rb = adidasRank[a], adidasRank[b]
    if ra and rb then return ra < rb end
    if ra then return true end
    if rb then return false end
    return a:lower() < b:lower()
end)

local buttonsByName = {}

-- ═══ CRÉATION DES BOUTONS (style Nova Hub) ═══
local function createButton(name, order)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = T.CARD
    btn.BackgroundTransparency = 0.2
    btn.TextColor3 = T.TEXT
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Text = name
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.LayoutOrder = order
    btn.BorderSizePixel = 0
    btn.ZIndex = 17
    btn.Parent = scroll
    local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 8); bc.Parent = btn

    local bStroke = Instance.new("UIStroke")
    bStroke.Color = T.PRIMARY
    bStroke.Thickness = 1
    bStroke.Transparency = 0.6
    bStroke.Parent = btn

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 12)
    padding.Parent = btn

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 3, 1, 0)
    bar.Position = UDim2.new(0, 0, 0, 0)
    bar.BackgroundColor3 = T.PRIMARY
    bar.BorderSizePixel = 0
    bar.ZIndex = 18
    bar.Parent = btn
    local barc = Instance.new("UICorner"); barc.CornerRadius = UDim.new(0, 2); barc.Parent = bar

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, F, { BackgroundColor3 = T.PRIMARY_DARK, BackgroundTransparency = 0.4 }):Play()
        TweenService:Create(bStroke, F, { Transparency = 0, Thickness = 2 }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, F, { BackgroundColor3 = T.CARD, BackgroundTransparency = 0.2 }):Play()
        TweenService:Create(bStroke, F, { Transparency = 0.6, Thickness = 1 }):Play()
    end)

    btn.MouseButton1Click:Connect(function()
        local ok = applyPack(name)
        current.Text = ok and ("Current: " .. name) or ("Current: (failed) " .. name)
    end)

    buttonsByName[name] = btn
end

for i, name in ipairs(allNames) do
    createButton(name, i)
end
refreshCanvas()

